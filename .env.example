# ── Supabase (vlastní projekt Geo Studia) ────────────────────────────────────────
# Dashboard → Project Settings → API. ANON klíč je veřejný (chrání ho RLS), service_role
# klíč do frontendu NIKDY nepatří.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON=

# ── Cesium ion ──────────────────────────────────────────────────────────────────
# https://ion.cesium.com → Access Tokens. Potřeba jen pro Google Photorealistic 3D Tiles
# a OSM budovy; terén DMR i ortofoto jedou přímo z ČÚZK bez tokenu.
VITE_CESIUM_ION_TOKEN=

# ── Volitelné: lokální dlaždicový server (npm run tiles) ─────────────────────────
# VITE_LOCAL_TILES=http://localhost:8788

# ── Volitelné: strop na velikost jednoho nahrávaného souboru (MB) ────────────────
# Musí sedět s „Global file size limit" v Supabase → Storage Settings. Free tarif má
# tvrdých 50 MB a víc nepustí ani resumable upload. Po přechodu na Pro zvedni limit
# v Supabase a stejné číslo dej sem, jinak appka odmítne soubor dřív než server.
# VITE_MAX_UPLOAD_MB=50
