    "test:terrain": "node --import ./scripts/ts-resolve.mjs scripts/test-terrain.mjs",
    "test:dxf": "node --import ./scripts/ts-resolve.mjs scripts/test-dxf.mjs",
    "test:savequeue": "node --import ./scripts/ts-resolve.mjs scripts/test-savequeue.mjs",
    "test:export": "node --import ./scripts/ts-resolve.mjs scripts/test-export.mjs",
    "test:perf": "node --import ./scripts/ts-resolve.mjs scripts/test-perf.mjs",
    "test:geoid": "node --import ./scripts/ts-resolve.mjs scripts/test-geoid.mjs",
    "test": "npm run test:section && npm run test:terrain && npm run test:dxf && npm run test:savequeue && npm run test:export && npm run test:perf && npm run test:geoid"
  },
  "dependencies": {
